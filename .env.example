# Banco (SQLite, arquivo local)
DB_FILE=./data/ig-insights.db

# Browser
# Deixe vazio para usar o Chrome instalado (channel=chrome).
CHROME_PATH=
PROFILE_DIR=./data/profile
WINDOW_WIDTH=1366
WINDOW_HEIGHT =820
LOCALE=pt-BR
TZ_NAME=America/Sao_Paulo

# Armazenamento
RAW_DIR=./data/raw
MEDIA_DIR=./data/media

# Orcamento de acoes
# janela horaria: 0 a 24 = sem restricao
COLLECT_WINDOW_START=0
COLLECT_WINDOW_END=24
MAX_SESSIONS_PER_DAY=3
# 0 = sem dias de folga
REST_DAYS_PER_WEEK=0
MAX_SCROLLS=10
SESSION_MAX_MINUTES=15
MAX_AUTHOR_SESSIONS_PER_DAY=2
MAX_AUTHORS_PER_SESSION=15
AUTHOR_STALE_DAYS=30

# busca por palavra (npm run busca)
MAX_SEARCH_SESSIONS_PER_DAY=6
SEARCH_SCROLLS=6
SEARCH_TERMS_FILE=./termos.txt

# Enriquecimento (Fase 3)
ANTHROPIC_API_KEY=
# se este id der 404, rode: npm run cli -- models
ANTHROPIC_MODEL=claude-haiku-4-5
ENRICH_TARGET_WIDTH=720
ENRICH_CONCURRENCY=3

# Transcricao local (opcional — precisa de ffmpeg e whisper no PATH)
FFMPEG_BIN=ffmpeg
WHISPER_MODEL=small
# quantos whisper rodam ao mesmo tempo (0 = automatico: 1 a cada 4 nucleos, ate 4)
WHISPER_PARALELO=0
# reels transcritos por ciclo (0 = todos os da janela da persona)
WHISPER_POR_CICLO=0
WHISPER_LANG=pt
# whisper.cpp: whisper-cli -m modelo.bin -l {lang} -otxt -of "{outdir}/saida" -f "{input}"
# Caminho completo com aspas? Envolva o valor INTEIRO em aspas simples, senao o
# dotenv corta tudo depois da primeira aspa dupla:
# WHISPER_CMD='"C:\caminho\whisper-ctranslate2.exe" "{input}" --model {model} ...'
WHISPER_CMD=whisper-ctranslate2 "{input}" --model {model} --language {lang} --vad_filter True --output_format txt --output_dir "{outdir}"

# Observabilidade
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# acompanhamento de perfis (npm run acompanhar)
WATCH_PER_SESSION=8
WATCH_MIN_HOURS=20

# creator: grafo das sementes e pauta semanal (docs/creator.md)
# 0 = sem teto diario
MAX_FOLLOWING_SESSIONS_PER_DAY=0
SEGUINDO_POR_SESSAO=5
SEGUINDO_MAX_POR_SEMENTE=500
SEGUINDO_MIN_DIAS=7
# 0 = automatico: 30% das sementes, minimo 2
GRAFO_MIN_SEMENTES=0
GRAFO_MAX_CONTAS=40
JANELA_DIAS=30
PAUTA_IDEIAS=5
RADAR_TEMAS=3
SEMANA_RODADAS_ACOMPANHAR=0
# vazio = ANTHROPIC_MODEL. A pauta pede um modelo melhor que o haiku, se der
CREATOR_MODEL=
PAUTA_MODEL=

# Postgres (Supabase, Session pooler): ainda nao usado pelo codigo
DATABASE_URL=
